[Unit]
PartOf=ouranos.target
Description=Ouranos Alloy
Wants=loki.service tempo.service mimir.service podman.socket
After=loki.service tempo.service mimir.service podman.socket

[Container]
Image=docker.io/grafana/alloy:v1.20.1
ContainerName=alloy
Network=ouranos.network
PublishPort=12345:12345
PublishPort=4317:4317
PublishPort=4318:4318
Volume=@REPO@/stacks/infrastructure/grafana/alloy-local-config.yaml:/etc/alloy/config.alloy:ro
# Podman's Docker-compatible API, so the discovery.docker config works unchanged.
Volume=/run/podman/podman.sock:/var/run/docker.sock
Exec=run --server.http.listen-addr=0.0.0.0:12345 --storage.path=/var/lib/alloy/data /etc/alloy/config.alloy

[Service]
Restart=always

[Install]
WantedBy=ouranos.target
