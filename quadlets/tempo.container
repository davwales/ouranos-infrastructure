[Unit]
PartOf=ouranos.target
Description=Ouranos Tempo

[Container]
Image=docker.io/grafana/tempo:3.0.3
ContainerName=tempo
User=root
Network=ouranos.network
PublishPort=3200:3200
Volume=@REPO@/stacks/infrastructure/grafana/tempo-config.yaml:/etc/tempo.yaml:ro
Volume=@REPO@/stacks/infrastructure/grafana/.data/tempo:/var/tempo
Exec=-config.file=/etc/tempo.yaml

[Service]
Restart=always

[Install]
WantedBy=ouranos.target
