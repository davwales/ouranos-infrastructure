[Unit]
PartOf=ouranos.target
Description=Ouranos Mimir

[Container]
Image=docker.io/grafana/mimir:3.2.0
ContainerName=mimir
Network=ouranos.network
PublishPort=9009:9009
Volume=@REPO@/config/mimir/config.yaml:/etc/mimir/mimir.yaml:ro
Volume=mimir_data.volume:/data
Exec=--config.file=/etc/mimir/mimir.yaml

[Service]
Restart=always

[Install]
WantedBy=ouranos.target
