[Unit]
Description=Ouranos Pantheon interface

[Container]
Image=ghcr.io/davwales/ouranos-pantheon/interface:latest
ContainerName=pantheon-interface
# Updated by podman-auto-update.timer.
AutoUpdate=registry
Network=ouranos.network
PublishPort=80:3000
# Server-side rendering reaches the gateway over the container network; the browser derives its own URL.
Environment=API_BASE=http://pantheon-gateway:8300

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
