[Unit]
PartOf=ouranos.target
Description=Ouranos Grafana
Wants=loki.service
After=loki.service

[Container]
Image=docker.io/grafana/grafana:13.1.4
ContainerName=grafana
Network=ouranos.network
PublishPort=3000:3000
Environment=GF_PATHS_PROVISIONING=/etc/grafana/provisioning
Environment=GF_AUTH_ANONYMOUS_ENABLED=true
Environment=GF_AUTH_ANONYMOUS_ORG_ROLE=Admin
Volume=grafana_data.volume:/var/lib/grafana
Volume=@REPO@/stacks/infrastructure/grafana/provisioning/datasources:/etc/grafana/provisioning/datasources:ro
HealthCmd=wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5

[Service]
Restart=always

[Install]
WantedBy=ouranos.target
