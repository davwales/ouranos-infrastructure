COMPOSE_PROJECT_NAME=ouranos

# GitHub Actions self-hosted runner registration.
# Use RUNNER_TOKEN (short-lived, from repo Settings > Actions > Runners > New self-hosted runner)
# OR ACCESS_TOKEN (fine-grained PAT with "Administration: Read & write" on the repo)
# for restart-resilient auto-registration. Set real values in .env (gitignored).
RUNNER_TOKEN=
ACCESS_TOKEN=
